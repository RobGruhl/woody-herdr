{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "clawdr-chrome",
            "props": {
              "painted": true
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "paper-agents",
                "props": {
                  "cards": true
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "clawdr-chrome",
            "props": {
              "footer": true,
              "painted": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "paper-tabs",
                "props": {
                  "plain": true
                }
              },
              "window_drag": true
            },
            {
              "id": "texture",
              "type": "block",
              "size": {
                "px": 112
              },
              "content": {
                "mod": "paper-texture",
                "props": {
                  "painted": true
                }
              }
            },
            {
              "id": "appearance",
              "type": "block",
              "size": {
                "px": 40
              },
              "content": {
                "mod": "appearance-toggle"
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "paper-pane",
                      "props": {
                        "painted": true
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "backgrounds/paper-light-f4e8d8.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "paper-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "paper-changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "paper-status",
            "props": {
              "plain": true
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/walnut.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/paper-grain.png",
  "theme": {
    "light": "walnut-parchment",
    "dark": "graphite"
  },
  "floating": [
    {
      "id": "paper-sync",
      "content": {
        "mod": "paper-sync"
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}